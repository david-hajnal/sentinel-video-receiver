# RTSP Camera Configuration
RTSP_USER=admin
RTSP_PASS=password123

# TCP Interleaved Mode Settings
TCP_RTSP_HOST=192.168.1.100
TCP_RTSP_PORT=554
TCP_RTSP_PATH=/stream1
TCP_OUTPUT_FILE=tcp_out.h264

# UDP Mode Settings
UDP_RTSP_HOST=192.168.1.100
UDP_RTSP_PORT=554
UDP_RTSP_PATH=/stream2
UDP_RTP_PORT=5004
UDP_RTCP_PORT=5005
UDP_OUTPUT_FILE=udp_out.h264

ONVIF_HOST=192.168.1.100
ONVIF_PORT=2020
ONVIF_USER='admin'
ONVIF_PASS='your_password_here'
ONVIF_DEBUG=1

RTSP_URL='rtsp://192.168.1.100:554/stream2'
RTSP_HOST='192.168.1.100'
RTSP_PORT='554'
RTSP_USER='admin'
RTSP_PASS='your_password_here'

# Clip recorder
CLIP_DIR=clips
CLIP_PRE_ROLL_SECS=2
CLIP_POST_ROLL_SECS=3
CLIP_DEBOUNCE_MS=300
CLIP_FPS=25
CLIP_STREAM_COPY=1

# Clip rotation/cleanup (optional)
# Maximum number of .mp4 files to keep (oldest deleted first)
# CLIP_MAX_FILES=100
# Maximum age of clips in seconds (7 days = 604800)
# CLIP_MAX_AGE_SECS=604800
# Maximum total size of all clips in bytes (10 GB = 10737418240)
# CLIP_MAX_TOTAL_BYTES=10737418240

# Clip size and duration limits (optional)
# Maximum size per clip in bytes (50 MB = 52428800)
# CLIP_MAX_BYTES=52428800
# Maximum duration per clip in seconds
# CLIP_MAX_SECS=60

ONVIF_AFTER_SUB_DELAY_MS=4000
ONVIF_CONNREFUSED_RETRIES=20
ONVIF_CONNREFUSED_BACKOFF_MS=250

# Agent Configuration
# Camera identifier (defaults to ONVIF_HOST if not set)
# CAMERA_ID=cam-001

# Server integration (optional)
# MOTION_ENABLED=true
# SERVER_ENABLED=false
# SERVER_BASE_URL=https://api.example.com
# SERVER_BEARER_TOKEN=your_token_here
# SERVER_RETRY_INTERVAL_SECS=30
# SERVER_MAX_RETRIES=5  # Max retry attempts before dropping message (0=infinite)

# Disk cleanup (optional)
# Check interval in seconds for disk space monitoring
# CLIP_CLEANUP_INTERVAL_SECS=60
# Minimum free space in bytes (1 GB = 1073741824)
# CLIP_MIN_FREE_BYTES=1073741824

# Dummy Server Configuration (for testing)
# DUMMY_SERVER_BIND=127.0.0.1:8080
# DUMMY_SERVER_TOKEN=test-token-12345
