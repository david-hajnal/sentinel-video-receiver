# RTSP Camera Configuration
RTSP_USER=admin
RTSP_PASS=password123

# TCP Interleaved Mode Settings
TCP_RTSP_HOST=192.168.1.100
TCP_RTSP_PORT=554
TCP_RTSP_PATH=/stream1
TCP_OUTPUT_FILE=tcp_out.h264

# UDP Mode Settings
UDP_RTSP_HOST=192.168.1.100
UDP_RTSP_PORT=554
UDP_RTSP_PATH=/stream2
UDP_RTP_PORT=5004
UDP_RTCP_PORT=5005
UDP_OUTPUT_FILE=udp_out.h264

ONVIF_HOST=192.168.1.100
ONVIF_PORT=2020
ONVIF_USER='admin'
ONVIF_PASS='your_password_here'
ONVIF_DEBUG=1

RTSP_URL='rtsp://192.168.1.100:554/stream2'
RTSP_HOST='192.168.1.100'
RTSP_PORT='554'
RTSP_USER='admin'
RTSP_PASS='your_password_here'

# Clip recorder
CLIP_DIR=clips
CLIP_PRE_ROLL_SECS=2
CLIP_POST_ROLL_SECS=3
CLIP_DEBOUNCE_MS=300
CLIP_FPS=25
CLIP_STREAM_COPY=1

ONVIF_AFTER_SUB_DELAY_MS=4000
ONVIF_CONNREFUSED_RETRIES=20
ONVIF_CONNREFUSED_BACKOFF_MS=250
