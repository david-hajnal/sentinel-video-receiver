use anyhow::{anyhow, Context, Result};
use chrono::Utc;
use md5::Digest;
use std::{collections::VecDeque, path::PathBuf, time::Duration};
use tokio::{
    io::AsyncWriteExt,
    process::{Child, ChildStdin, Command},
    sync::mpsc,
    time::{Instant},
};
use tokio_util::sync::CancellationToken;

use crate::event_bus::{Event, MotionEvent};
use crate::video::{nal_type_from_annexb, VideoNal};

const RTP_CLOCK_HZ: u32 = 90_000;

#[derive(Clone, Debug)]
pub struct ClipRecorderConfig {
    pub output_dir: PathBuf,
    pub pre_roll: Duration,
    pub post_roll: Duration,
    pub debounce: Duration,
    pub assumed_fps: u32, // fallback, keep 25
    pub stream_copy: bool, // true => -c:v copy
}

impl ClipRecorderConfig {
    pub fn from_env() -> Self {
        let pre = std::env::var("CLIP_PRE_ROLL_SECS").ok().and_then(|v| v.parse::<u64>().ok()).unwrap_or(2);
        let post = std::env::var("CLIP_POST_ROLL_SECS").ok().and_then(|v| v.parse::<u64>().ok()).unwrap_or(3);
        let deb = std::env::var("CLIP_DEBOUNCE_MS").ok().and_then(|v| v.parse::<u64>().ok()).unwrap_or(300);
        let fps = std::env::var("CLIP_FPS").ok().and_then(|v| v.parse::<u32>().ok()).unwrap_or(25);
        let copy = std::env::var("CLIP_STREAM_COPY").ok().map(|v| v != "0").unwrap_or(true);
        let out = std::env::var("CLIP_DIR").unwrap_or_else(|_| "clips".to_string());

        Self {
            output_dir: out.into(),
            pre_roll: Duration::from_secs(pre),
            post_roll: Duration::from_secs(post),
            debounce: Duration::from_millis(deb),
            assumed_fps: fps,
            stream_copy: copy,
        }
    }
}

enum State {
    Idle,
    PendingStart { rule: String, since: Instant },
    Recording {
        rule: String,
        child: Child,
        stdin: ChildStdin,
        stop_at: Option<Instant>,
        file_path: PathBuf,
        // used for pacing
        first_ts: u32,
        last_ts: u32,
        start_wall: Instant,
    },
}

pub struct ClipRecorder {
    cfg: ClipRecorderConfig,
    state: State,
    ring: VecDeque<VideoNal>,
    last_sps: Option<Vec<u8>>,
    last_pps: Option<Vec<u8>>,
}

impl ClipRecorder {
    pub fn new(cfg: ClipRecorderConfig) -> Self {
        Self {
            cfg,
            state: State::Idle,
            ring: VecDeque::new(),
            last_sps: None,
            last_pps: None,
        }
    }

    pub async fn run(
        mut self,
        mut motion_rx: mpsc::Receiver<Event>,
        mut nal_rx: mpsc::Receiver<VideoNal>,
        cancel: CancellationToken,
    ) -> Result<()> {
        tokio::fs::create_dir_all(&self.cfg.output_dir).await?;

        loop {
            tokio::select! {
                _ = cancel.cancelled() => {
                    self.stop_recording().await?;
                    break;
                }

                Some(ev) = motion_rx.recv() => {
                    if let Event::Motion(m) = ev { self.on_motion(m).await?; }
                }

                Some(n) = nal_rx.recv() => {
                    self.on_nal(n).await?;
                }

                else => break,
            }
        }

        Ok(())
    }

    async fn on_motion(&mut self, m: MotionEvent) -> Result<()> {
        if m.active {
            self.state = State::PendingStart { rule: m.rule, since: Instant::now() };
        } else {
            match &mut self.state {
                State::Recording { stop_at, .. } => {
                    *stop_at = Some(Instant::now() + self.cfg.post_roll);
                }
                State::PendingStart { .. } => {
                    self.state = State::Idle;
                }
                State::Idle => {}
            }
        }
        Ok(())
    }

    async fn on_nal(&mut self, n: VideoNal) -> Result<()> {
        // Cache SPS/PPS
        if let Some(nt) = nal_type_from_annexb(&n.data) {
            match nt {
                7 => { self.last_sps = Some(n.data.clone()); }
                8 => { self.last_pps = Some(n.data.clone()); }
                _ => {}
            }
        }

        // Maintain ring buffer using RTP timebase
        self.ring_push(n);

        // State machine
        match &mut self.state {
            State::Idle => {}

            State::PendingStart { rule, since } => {
                if since.elapsed() < self.cfg.debounce {
                    return Ok(());
                }
                // Start only when we see an IDR and have SPS/PPS
                if let Some(last) = self.ring.back() {
                    if nal_type_from_annexb(&last.data) == Some(5) && self.last_sps.is_some() && self.last_pps.is_some() {
                        let rule_clone = rule.clone();
                        let (child, stdin, file_path) = self.spawn_ffmpeg(&rule_clone).await?;
                        let first_ts = last.rtp_ts;

                        // Write pre-roll: start from most recent IDR inside ring
                        let flush = self.build_preroll_flush();
                        let mut st = State::Recording {
                            rule: rule_clone,
                            child,
                            stdin,
                            stop_at: None,
                            file_path,
                            first_ts,
                            last_ts: first_ts,
                            start_wall: Instant::now(),
                        };

                        self.write_nals(&mut st, flush).await?;
                        self.state = st;
                    }
                }
            }

            State::Recording { stop_at, .. } => {
                if let Some(t) = *stop_at {
                    if Instant::now() >= t {
                        self.stop_recording().await?;
                        return Ok(());
                    }
                }

                // Feed latest nal (already in ring.back())
                if let Some(last) = self.ring.back() {
                    self.write_nals(&mut self.state, vec![last.clone()]).await?;
                }
            }
        }

        Ok(())
    }

    fn ring_push(&mut self, n: VideoNal) {
        self.ring.push_back(n);

        // Keep only last pre_roll seconds (based on RTP ts delta)
        while self.ring.len() > 2 {
            let first = &self.ring[0];
            let last = self.ring.back().unwrap();
            let dt_ticks = last.rtp_ts.wrapping_sub(first.rtp_ts);
            let dt_secs = (dt_ticks as f64) / (RTP_CLOCK_HZ as f64);
            if dt_secs <= self.cfg.pre_roll.as_secs_f64() {
                break;
            }
            self.ring.pop_front();
        }
    }

    /// Build NAL list to flush at start: SPS/PPS + ring from nearest IDR.
    fn build_preroll_flush(&self) -> Vec<VideoNal> {
        let mut out: Vec<VideoNal> = Vec::new();

        // Start with SPS/PPS
        if let Some(sps) = self.last_sps.clone() {
            out.push(VideoNal { data: sps, rtp_ts: self.ring.back().map(|x| x.rtp_ts).unwrap_or(0), marker: false });
        }
        if let Some(pps) = self.last_pps.clone() {
            out.push(VideoNal { data: pps, rtp_ts: self.ring.back().map(|x| x.rtp_ts).unwrap_or(0), marker: false });
        }

        // Find last IDR in ring; start from there; else start from ring front
        let mut start_idx = 0usize;
        for (i, n) in self.ring.iter().enumerate() {
            if nal_type_from_annexb(&n.data) == Some(5) {
                start_idx = i;
            }
        }
        out.extend(self.ring.iter().skip(start_idx).cloned());
        out
    }

    async fn write_nals(&mut self, st: &mut State, nals: Vec<VideoNal>) -> Result<()> {
        let (stdin, first_ts, last_ts, start_wall) = match st {
            State::Recording { stdin, first_ts, last_ts, start_wall, .. } => (stdin, *first_ts, last_ts, *start_wall),
            _ => return Ok(()),
        };

        for n in nals {
            // Pace based on RTP timestamps so ffmpeg sees a stable stream
            let rel_ticks = n.rtp_ts.wrapping_sub(first_ts);
            let rel = Duration::from_secs_f64(rel_ticks as f64 / RTP_CLOCK_HZ as f64);
            let target = start_wall + rel;
            if let Some(wait) = target.checked_duration_since(Instant::now()) {
                // Don't sleep huge if system lags
                if wait < Duration::from_millis(200) {
                    tokio::time::sleep(wait).await;
                }
            }

            // Robustness: prepend SPS/PPS before IDR
            if nal_type_from_annexb(&n.data) == Some(5) {
                if let (Some(sps), Some(pps)) = (self.last_sps.as_ref(), self.last_pps.as_ref()) {
                    stdin.write_all(sps).await.ok();
                    stdin.write_all(pps).await.ok();
                }
            }

            stdin.write_all(&n.data).await.context("ffmpeg stdin write")?;
            *last_ts = n.rtp_ts;
        }

        Ok(())
    }

    async fn stop_recording(&mut self) -> Result<()> {
        if let State::Recording { mut child, mut stdin, file_path, .. } =
            std::mem::replace(&mut self.state, State::Idle)
        {
            // Close stdin => ffmpeg finalizes MP4 (prevents corruption)
            let _ = stdin.shutdown().await;

            match tokio::time::timeout(Duration::from_secs(6), child.wait()).await {
                Ok(Ok(status)) if status.success() => {
                    println!("✅ saved clip {:?}", file_path);
                }
                Ok(Ok(status)) => {
                    eprintln!("⚠ ffmpeg exit {status} for {:?}", file_path);
                }
                Ok(Err(e)) => {
                    eprintln!("⚠ ffmpeg wait error {e} for {:?}", file_path);
                }
                Err(_) => {
                    let _ = child.kill().await;
                    eprintln!("⚠ ffmpeg kill (hang) for {:?}", file_path);
                }
            }
        }
        Ok(())
    }

    async fn spawn_ffmpeg(&self, rule: &str) -> Result<(Child, ChildStdin, PathBuf)> {
        let ts = Utc::now().format("%Y%m%d_%H%M%S%.3fZ").to_string();
        let safe_rule = rule.replace(['/', '\\', ' '], "_");

        // md5 suffix (rule + timestamp + random-ish)
        let md5_in = format!("{safe_rule}-{ts}-{}", rand::random::<u64>());
        let md5_hex = format!("{:x}", md5::compute(md5_in));
        let suffix = &md5_hex[0..8];

        let file_path = self.cfg.output_dir.join(format!("{ts}_{safe_rule}_{suffix}.mp4"));

        let mut cmd = Command::new("ffmpeg");
        cmd.arg("-hide_banner")
            .arg("-loglevel").arg("error")
            .arg("-y")
            // Raw H264 from stdin. We still pass -r as fallback, but we pace by RTP ts.
            .arg("-r").arg(self.cfg.assumed_fps.to_string())
            .arg("-f").arg("h264")
            .arg("-i").arg("pipe:0");

        if self.cfg.stream_copy {
            cmd.arg("-c:v").arg("copy");
        } else {
            cmd.arg("-c:v").arg("libx264")
               .arg("-preset").arg("veryfast")
               .arg("-tune").arg("zerolatency");
        }

        cmd.arg("-movflags").arg("+faststart")
           .arg(file_path.to_string_lossy().to_string())
           .stdin(std::process::Stdio::piped())
           .stdout(std::process::Stdio::null())
           .stderr(std::process::Stdio::piped());

        let mut child = cmd.spawn().context("spawn ffmpeg")?;
        let stdin = child.stdin.take().ok_or_else(|| anyhow!("ffmpeg stdin missing"))?;
        Ok((child, stdin, file_path))
    }
}
